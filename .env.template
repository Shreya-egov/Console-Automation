# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# Login page of the environment under test.
BASE_URL=https://hcm-demo.digit.org/workbench-ui/employee/user/login

# Credentials of a user with campaign-manager rights on that environment.
